# Database
DATABASE_URL=sqlite://data/gavin.db

# Upload directory
UPLOAD_DIR=data/uploads

# Frontend static files
FRONTEND_DIR=dist

# Public domain used to derive the default OIDC callback URL
PUBLIC_DOMAIN=gavin.restanrm.fr

# Server
HOST=127.0.0.1
PORT=3000

# Authentication mode: "oidc" (default, production) or "dev" (development, no auth required)
AUTH_MODE=oidc

# OIDC Configuration (required when AUTH_MODE=oidc)
OIDC_ISSUER_URL=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
# Optional; defaults to https://${PUBLIC_DOMAIN}/api/auth/callback
OIDC_REDIRECT_URL=https://gavin.restanrm.fr/api/auth/callback

# Session (required when AUTH_MODE=oidc, optional for dev)
SESSION_SECRET=your-random-secret-at-least-64-chars-long-please-change-this
COOKIE_SECURE=false

# Internet album metadata enrichment (MusicBrainz + Cover Art Archive)
ALBUM_METADATA_ENABLED=true
# Optional but recommended if deploying publicly; MusicBrainz asks clients to identify themselves.
ALBUM_METADATA_USER_AGENT="gavin/0.1.0 (https://gavin.restanrm.fr)"
# Album-cover photo recognition. Use 'gemini' for Google AI Studio free tier,
# 'openai' for ChatGPT/OpenAI API, or 'disabled'. If unset, Gemini is selected
# when GEMINI_API_KEY is present, otherwise OpenAI is selected.
ALBUM_COVER_RECOGNITION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_ALBUM_COVER_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_ALBUM_COVER_MODEL=gpt-4o-mini
MUSICBRAINZ_BASE_URL=https://musicbrainz.org
COVER_ART_ARCHIVE_BASE_URL=https://coverartarchive.org

# Logging
RUST_LOG=info,gavin=debug
