# Quick development environment - no OIDC setup required
# Copy this to .env for local development:
#   cp .env.dev .env

# Authentication - DEV mode disables OIDC and enables admin only after clicking Login
AUTH_MODE=dev

# Database
DATABASE_URL=sqlite://data/gavin.db

# Upload directory
UPLOAD_DIR=data/uploads

# Frontend static files
FRONTEND_DIR=dist

# Public domain can be overridden for local/test callbacks
PUBLIC_DOMAIN=localhost:3000

# Server
HOST=127.0.0.1
PORT=3000

# Session (optional in dev mode, using defaults)
COOKIE_SECURE=false

# Logging
RUST_LOG=info,gavin=debug
